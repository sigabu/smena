<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#356353</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F5F5EF</item>
        <item name="android:navigationBarColor">#173E35</item>
        <item name="android:statusBarColor">#F5F5EF</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="BaseAppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D6ED91</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#111C18</item>
        <item name="android:navigationBarColor">#111C18</item>
        <item name="android:statusBarColor">#111C18</item>
    </style>
    <style name="AppThemeDark" parent="BaseAppThemeDark" />
</resources>
